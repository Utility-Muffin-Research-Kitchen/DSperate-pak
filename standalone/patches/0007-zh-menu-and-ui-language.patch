 #include <iterator>
 
 namespace ds::sdl {
+
+// The current UI language, mirrored from the "ui.language" config key every
+// frame by Menu::draw. Starts in English; the first draw corrects it.
+UiLang g_ui_lang = UiLang::En;
+
+// The translation table (zh <-> en). Generated by tools/gen_tr.py from the
+// localization patch; both directions are searched so a string already written
+// in either language resolves to the other.
+#include "frontend/sdl/tr_data.inc"
+
+// Resolve `s` to the string for the current UI language. In English mode a
+// Chinese literal becomes its English; in Chinese mode an English literal
+// becomes its Chinese. Anything not in kTr is returned unchanged, so strings the
+// translator never saw keep whatever language they were written in. Called from
+// text_width and draw_text, so width and paint always agree on the text.
+const char* tr_text(const char* s) {
+  if (!s || !*s) return s;
+  if (g_ui_lang == UiLang::En) {
+    for (int i = 0; i < kTrN; ++i)
+      if (std::strcmp(kTr[i].zh, s) == 0) return kTr[i].en;
+  } else {
+    for (int i = 0; i < kTrN; ++i)
+      if (std::strcmp(kTr[i].en, s) == 0) return kTr[i].zh;
+  }
+  return s;
+}
