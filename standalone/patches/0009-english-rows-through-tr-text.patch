+// Off unless the tests switch it on. A string the drawing is about to paint
+// that the table cannot translate is a row the player reads in the wrong
+// language, and with English set there is nothing on screen to tell that from
+// a row that was drawn in English: a leak and a correct row look the same. The
+// tests turn this on and walk every page, and what it counts is the only way
+// the drawing can be held to the one rule the table cannot enforce on its own.
+bool g_strict_i18n = false;
+int g_i18n_leaks = 0;
+
+// A Han character or fullwidth form, from the U+2E80 threshold the layout uses
+// to decide a code point is drawn as a square.
+bool has_cjk(const char* s) {
+  for (const char* p = s; *p;) {
+    const unsigned char b = static_cast<unsigned char>(*p++);
+    const int len = b >= 0xF0 ? 4 : b >= 0xE0 ? 3 : b >= 0xC0 ? 2 : 0;
+    if (len == 0) continue;
+    u32 cp = b & (0x7F >> len);
+    for (int i = 1; i < len && *p; ++i, ++p) {
+      const unsigned char c = static_cast<unsigned char>(*p);
+      if ((c & 0xC0) != 0x80) break;
+      cp = (cp << 6) | (c & 0x3F);
+    }
+    if (cp >= 0x2E80) return true;
+  }
+  return false;
+}
+
+// Counted, not raised: the menu is not the place for an exception, and one bad
+// row must not take the emulator down with it.
+void note_i18n(const char* s) {
+  if (g_strict_i18n && g_ui_lang == UiLang::En && has_cjk(s)) ++g_i18n_leaks;
+}
