diff --git a/tests/input_test.cpp b/tests/input_test.cpp
index b1c9fb0..983361b 100644
--- a/tests/input_test.cpp
+++ b/tests/input_test.cpp
@@ -300,6 +300,32 @@ void test_pad_labels() {
   for (const auto& p : pairs) CHECK(Input::pad_label(p[0]) == Input::pad_label(p[1]));
 }
 
+// The same pips on a pad that names x and y by the letter printed on the button
+// rather than by its place in the diamond -- the MLP1, whose SDL x is the
+// X-labelled button at the top and whose SDL y is the Y-labelled one on the
+// left. A row bound to SDL x has to point at the top button; left alone it
+// points at the left one, and the player presses a button that does nothing.
+void test_pad_labels_on_a_print_named_pad() {
+  Rig r; r.set("pad.xy_naming", "printed").go();
+  CHECK(Input::pad_label("x") == "\x04 NORTH");
+  CHECK(Input::pad_label("y") == "\x03 WEST");
+  CHECK(Input::pad_label("mod+x") == "MOD+\x04 NORTH");
+  // a and b are named by position on this pad too, so they do not move.
+  CHECK(Input::pad_label("a") == "\x01 SOUTH");
+  CHECK(Input::pad_label("b") == "\x02 EAST");
+  // A compass alias still names the button the pip points at.
+  CHECK(Input::pad_label("west") == "\x03 WEST");
+  CHECK(Input::pad_label("north") == "\x04 NORTH");
+  CHECK(Input::pad_label("west") == Input::pad_label("y"));
+  CHECK(Input::pad_label("north") == Input::pad_label("x"));
+  // And an unrecognised value is the old behaviour, said out loud.
+  Rig bad; bad.set("pad.xy_naming", "sideways").go();
+  CHECK(Input::pad_label("x") == "\x03 WEST");
+  Rig d; d.go();                                    // back to position, for the tests after this one
+  CHECK(Input::pad_label("x") == "\x03 WEST");
+  CHECK(Input::pad_label("y") == "\x04 NORTH");
+}
